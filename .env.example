POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hackathon
POSTGRES_PORT=5432

SECRET_KEY=changeme-generate-with-openssl-rand-hex-32

UPLOAD_DIR=/uploads

BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Postgres connection pool — TASK-16 sized backend/app/core/db.py for 300
# concurrent users. Override here only if the load profile changes.
# DB_POOL_SIZE=50
# DB_MAX_OVERFLOW=50

# --- TASK-13: XMPP / Jabber bridge (opt-in) -----------------------------------
# Off by default so v1.0.0 `docker compose up` behaves unchanged. To run the
# Prosody sidecar locally: set XMPP_ENABLED=1 and use the `jabber` profile:
#   docker compose --profile jabber up --build
XMPP_ENABLED=1
XMPP_HOST=prosody
XMPP_HTTP_PORT=5280
XMPP_DOMAIN=server-a.local
XMPP_ADMIN_TOKEN=dev-admin-token
XMPP_WEBHOOK_TOKEN=dev-webhook-token
